[
  {
    "label": "LaTeX: Build Document",
    "command": "latexmk",
    "args": ["-pdf", "-interaction=nonstopmode", "-synctex=1", "main.tex"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "LaTeX: Watch & Live Preview",
    "command": "latexmk",
    "args": ["-pvc", "-pdf", "-interaction=nonstopmode", "-synctex=1", "main.tex"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "LaTeX: Clean Auxiliary Files",
    "command": "latexmk",
    "args": ["-c"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "never"
  }
]
